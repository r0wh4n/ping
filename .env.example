# Copy to .env.local and fill in. Anything NEXT_PUBLIC_* is inlined into the
# client bundle at build time — never put a secret behind that prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push. The public VAPID key is meant to be public; the private half belongs
# only to the send-push edge function.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Calling (WebRTC) ────────────────────────────────────────────────────────
# STUN alone is enough for most home networks. Behind symmetric NAT — a lot of
# corporate wifi and some mobile carriers — the call needs a TURN relay or it
# will ring, connect ICE, and then fail. Roughly 1 in 6 networks.
#
# Comma-separated, most-preferred first. Include a turns:443 entry: on networks
# that only allow HTTPS-looking traffic it is the one that gets through.
# The relay only ever forwards DTLS-SRTP packets it cannot read.
#
# Preferred — self-hosted coturn (see deploy/coturn). Server-side only: /turn
# mints a short-lived HMAC credential per call, so the secret never ships to the
# browser and nobody can pull free bandwidth off your relay.
TURN_SECRET=
TURN_URL=turn:turn.theping.chat:3478,turns:turn.theping.chat:5349

# Fallback — a managed provider that issues long-lived credentials (Cloudflare
# Realtime, Twilio, Metered). These DO ship to the browser, so only use a
# provider where that is expected and quota-capped.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_CRED=
